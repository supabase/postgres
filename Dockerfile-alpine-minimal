    "/etc/postgresql/postgresql.conf" 2>/dev/null || true && \
    sed -i \
    -e 's/ timescaledb,//g' \
    -e 's/ plv8,//g' \
    -e 's/ pgroonga,//g' \
    -e 's/ postgis,//g' \
    -e 's/ pgrouting,//g' \
    -e 's/ wal2json,//g' \
    -e 's/ pg-safeupdate,//g' \
    -e 's/ pg_cron,//g' \
    -e 's/ pg_net,//g' \
    -e 's/ pg_graphql,//g' \
    -e 's/ pgmq,//g' \
    -e 's/ pg_repack,//g' \
    -e 's/ pg_tle,//g' \
    -e 's/ dblink,//g' \
