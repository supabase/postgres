[Unit]
Description=Run Supabase supabase-admin-agent salt on a schedule
Requires=supabase-admin-agent_salt.service

[Timer]
OnCalendar={{ supabase_admin_agent_timer.on_calendar }}
RandomizedDelaySec={{ supabase_admin_agent_splay }}
AccuracySec={{ supabase_admin_agent_timer.accuracy_sec }}
{% if supabase_admin_agent_timer.on_boot_sec %}
OnBootSec={{ supabase_admin_agent_timer.on_boot_sec }}
{% endif %}
Persistent=true

[Install]
WantedBy=timers.target
