[Unit]
Description=Configuration management via supabase-admin-agent salt
After=network.target local-fs.target tmp.mount
Wants=network-online.target
Requires=local-fs.target

[Service]
Type=oneshot
ExecStart=/opt/supabase-admin-agent/supabase-admin-agent --config /opt/supabase-admin-agent/config.yaml {{ supabase_admin_agent_salt.args }}
User={{ supabase_admin_agent_salt.user }}
Group={{ supabase_admin_agent_salt.group }}
StandardOutput=journal
StandardError=journal
StateDirectory=supabase-admin-agent
CacheDirectory=supabase-admin-agent
# set tempdir on permanent disk
Environment="TMPDIR=/var/tmp"

[Install]
WantedBy=multi-user.target
